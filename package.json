{
  "name": "mantl-slidebuilder",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Mantl-branded Slidev starter. Write slides in Markdown; the Mantl design system, components, and watermark are applied by default.",
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export",
    "export:clicks": "slidev export --with-clicks"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-seriph": "^0.25.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.44.0"
  }
}
